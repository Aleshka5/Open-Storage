# Namespace open-storage. Copy to .env beside this file. Do not commit .env.
# Postgres, Redis and MinIO are the common namespace on common_network.
# POSTGRES_USER and POSTGRES_PASSWORD match deploy/common/.env.
# S3_ACCESS_KEY and S3_SECRET_KEY match MINIO_ROOT_USER and MINIO_ROOT_PASSWORD.
# Compose sets DATABASE_URL, REDIS_URL and S3_ENDPOINT_URL from this file;
# those three lines document the names the process reads.
# Create database db_storage on postgres before the app migrates.

# --- Postgres (common: postgres:5432) ---
POSTGRES_DB=db_storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>

# --- Redis (common: redis:6379) ---
REDIS_URL=redis://redis:6379

# --- MinIO bucket `storage` (common: minio:9000) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET=storage
S3_PATH_STYLE=true

# Capacity of the single storage bucket
DISK_STRATEGY=most_free_space
DISK_SPACE_CACHE_TTL=30
MIN_FREE_SPACE_MB=500

# Private vault session length. The vault cookie name is not set here.
PRIVATE_SESSION_TTL_HOURS=4

# Business logic
PHOTO_BATCH_SIZE=30
THUMBNAIL_MAX_PX=400
DEFAULT_USER_QUOTA_MB=100
# STRANGER_QUOTA_MB is accepted as an alias of DEFAULT_USER_QUOTA_MB.

# Logging
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/homecloud/app.log
LOG_FILE_ROTATION=100 MB
LOG_FILE_RETENTION=30 days

# Built SPA directory inside the app image
SPA_STATIC_DIR=/opt/spa

# RAG indexing stays off. This compose file does not attach a RAG network.
RAG_ENABLED=false
RAG_BASE_URL=http://rag-edge:8080
RAG_TIMEOUT_SECONDS=10
RAG_SYNC_INTERVAL_SECONDS=60
RAG_INDEX_BATCH_SIZE=20
RAG_MAX_ATTEMPTS=8
RAG_INDEX_MAX_WAIT_SECONDS=3600
RAG_MAX_IMAGE_BYTES=10485760
RAG_BACKFILL_ENABLED=false
