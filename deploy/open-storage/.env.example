# Namespace open-storage. Copy into .env beside this file. Do not commit .env.
# Local infrastructure (Postgres, MinIO, Redis) is started by this namespace's
# compose file; the app reaches it by container name.

# --- Application database (deploy/open-storage/docker-compose.yaml: postgres) ---
POSTGRES_DB=db_storage
POSTGRES_USER=storage
# No default. A literal secret in a committed file is a defect.
POSTGRES_PASSWORD=
# The app builds DATABASE_URL from the three values above; any value set here
# overrides the built one.
# DATABASE_URL=postgresql+asyncpg://storage:changeme@open-storage-postgres:5432/db_storage

# --- Redis (deploy/open-storage/docker-compose.yaml: redis) ---
REDIS_URL=redis://open-storage-redis:6379

# --- MinIO, one bucket `storage` (deploy/open-storage/docker-compose.yaml: minio) ---
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in compose come from these two values.
S3_ENDPOINT_URL=http://open-storage-minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET=storage
S3_PATH_STYLE=true

# Capacity / health of the single storage bucket
DISK_STRATEGY=most_free_space
DISK_SPACE_CACHE_TTL=30
MIN_FREE_SPACE_MB=500

# Private vault cookie (identity is gateway headers, not this cookie)
AUTH_COOKIE_NAME=auth_session
PRIVATE_SESSION_TTL_HOURS=4

# User-Service on user_network (network trust, no JWT)
# NOTE: this namespace does not own user_network. Pending the identity migration
# the app still calls User-Service; the value below is the legacy one and the
# app cannot resolve it from open_network alone.
USER_SERVICE_URL=http://user_service:8000
USER_SERVICE_TIMEOUT_MS=2000
USER_SERVICE_CACHE_TTL_SECONDS=60

# Business logic
PHOTO_BATCH_SIZE=30
THUMBNAIL_MAX_PX=400
DEFAULT_USER_QUOTA_MB=100

# Logging
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/homecloud/app.log
LOG_FILE_ROTATION=100 MB
LOG_FILE_RETENTION=30 days

# Built SPA directory inside the app image
SPA_STATIC_DIR=/opt/spa

# RAG indexing. Off until the app is joined to rag_edge in the compose file.
RAG_ENABLED=false
RAG_BASE_URL=http://rag-edge:8080
RAG_TIMEOUT_SECONDS=10
RAG_SYNC_INTERVAL_SECONDS=60
RAG_INDEX_BATCH_SIZE=20
RAG_MAX_ATTEMPTS=8
RAG_INDEX_MAX_WAIT_SECONDS=3600
RAG_MAX_IMAGE_BYTES=10485760
RAG_BACKFILL_ENABLED=false
