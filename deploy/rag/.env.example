# Namespace rag. Copy to .env beside this file. Do not commit .env.
# Registry host for the images this namespace builds. docs/images.md.
# IMAGE_TAG=YYYY-MM-DD pins a date. Unset runs latest.
REGISTRY=registry.filenkov.store
# Every value here is empty. A key the process cannot run without is caught by
# `make doctor`; compose refuses to start on the four marked REQUIRED.
# Mongo, MinIO and RabbitMQ are the common namespace on common_network; the
# names below are the ones each process reads. See adrs/9-rag-namespace.md.

# --- common: Mongo, MinIO, RabbitMQ (common_network) ---
# REQUIRED: compose interpolation refuses an empty value.
MONGODB_URI=mongodb://mongo:27017/rag
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=storage
S3_REGION=us-east-1
RABBITMQ_URL=amqp://rabbit:5672/
RABBITMQ_EXCHANGE=doc_events
RABBITMQ_DLX=doc_events_dlq

# --- Qdrant (this namespace) ---
QDRANT_URL=http://rag-qdrant:6333
QDRANT_COLLECTION=documents
QDRANT_IMAGES_COLLECTION=images
QDRANT_UPSERT_BATCH=64

# --- Logging ---
LOG_LEVEL=info

# --- rag-edge ---
RAG_EDGE_PORT=8080
FILE_COLLECTOR_URL=http://file-collector:8081
CHAT_URL=http://chat:8082
FRONTEND_URL=http://frontend:3000
MAX_UPLOAD_BYTES=524288000

# --- file-collector ---
FILE_COLLECTOR_PORT=8081

# --- processor ---
PROCESSOR_CONCURRENCY=1
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=51
MAX_PROCESS_ATTEMPTS=8
MIN_EXTRACTED_CHARS=50
OCR_RENDER_DPI=300
OCR_TIMEOUT=120
OCR_MAX_ATTEMPTS=3
EMBEDDING_TIMEOUT=30
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIM=768
EMBEDDING_MAX_TOKENS=1024
EMBEDDING_MODEL=google/embeddinggemma-2

# Processor and deletion-worker share the sweep keys.
STALE_PROCESSING_SECONDS=900
SWEEP_INTERVAL_SECONDS=60
UPLOAD_REQUEUE_AFTER_SECONDS=120

# --- deletion-worker ---
DELETION_CONCURRENCY=1
DELETE_REQUEUE_AFTER_SECONDS=120

# --- chat ---
CHAT_PORT=8082
# REQUIRED: compose interpolation refuses an empty value.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
RAG_TOP_K=5
RAG_MIN_SCORE=0
RAG_CONTEXT_MESSAGES=10
IMAGE_SEARCH_CACHE_TTL_SECONDS=60
IMAGE_SEARCH_CACHE_SIZE=256
# Chat's own default is 10, so it gets its own key instead of the processor's 30.
CHAT_EMBEDDING_TIMEOUT=10

# --- embedding (cpu target) ---
EMBEDDING_URL=http://embedding:8091
EMBEDDING_PORT=8091
EMBEDDING_GGUF=embeddinggemma-2-Q8_0.gguf
EMBEDDING_MMPROJ=mmproj-embeddinggemma-2-Q8_0.gguf
EMBEDDING_CONTEXT=2048
EMBEDDING_MAX_IMAGES=4
EMBEDDING_MAX_IMAGE_BYTES=10485760

# --- ocr (cpu target) ---
OCR_URL=http://ocr:8090
OCR_PORT=8090
OCR_MODEL=surya-ocr-2

# Optional Hugging Face token. Empty downloads the public weights anonymously.
HF_TOKEN=
