# Namespace common. Copy to .env beside this file. Do not commit .env.
# Same keys as Common .env.common. Postgres and MinIO read this file.
# The compose file does not set POSTGRES_DB.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# MinIO data is the bind /media/aleksey/HardDisk/minio in docker-compose.yaml.
