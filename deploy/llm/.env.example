# Namespace llm. Copy to .env beside this file. Do not commit .env.
#
# LLM_API_KEY is the bearer both llama.cpp and LiteLLM accept and send.
# DATABASE_URL points at the shared Postgres on common_network (database db_litellm).
# LITELLM_MASTER_KEY is the key clients send to the router.

LLM_API_KEY=

LITELLM_MASTER_KEY=
UI_USERNAME=admin
UI_PASSWORD=

DATABASE_URL=postgresql://lite_llm:CHANGE_ME@postgres:5432/db_litellm
STORE_MODEL_IN_DB=True
