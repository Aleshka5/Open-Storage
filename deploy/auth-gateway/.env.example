# Namespace auth-gateway. Copy into .env beside this file. Do not commit .env.
# Shared names (LOG_LEVEL, PUBLIC_ORIGIN, COOKIE_DOMAIN) live in the repository .env.example.
# Remove IDP_BOOTSTRAP_* after the first start on an empty database.

GATEWAY_CONFIG=/etc/gateway/config.yaml
GATEWAY_SESSION_KEY=
IDP_CLIENT_SECRET=
IDP_ADMIN_SECRET=
IDP_DB_PASSWORD=
IDP_BOOTSTRAP_USER=
IDP_BOOTSTRAP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SWITCH_TOKEN=

# --- The owl chat (optional) ----------------------------------------------
# Unset is a working gateway: POST /api/chat answers 503 and nothing else
# changes. The model and the host come from `llm:` in the gateway config.
# Referenced there as api_key: "env:LLM_API_KEY".
LLM_API_KEY=
# Overrides `llm.host`, `llm.model`, and `llm.reasoning_effort` when set.
# Setting the empty value (LLM_REASONING_EFFORT=) also works: an empty name
# falls back to the config.
# LLM_HOST=http://litellm-proxy-server:4000/v1
# LLM_MODEL=gpt-4o-mini
# LLM_REASONING_EFFORT=none

# --- MLflow tracing (optional, independent of generation) -----------------
# Spans go to {endpoint}/v1/traces. Needs MLflow >= 3.6 on a SQL backend. An
# unparsable endpoint disables tracing and never fails the start.
# MLFLOW_TRACING_ENDPOINT=http://mlflow:5000
# MLFLOW_EXPERIMENT_ID=
