# Namespace audio. Copy to .env beside this file. Do not commit .env.
# Registry host for the images this namespace builds. docs/images.md.
# IMAGE_TAG=YYYY-MM-DD pins a date. Unset runs latest.
REGISTRY=registry.filenkov.store

# Required secrets are empty. `make doctor` fails while any of them is empty.
# Compose refuses to start on the same keys. No value here is a credential.

# --- common: Mongo, MinIO, RabbitMQ, Redis (common_network) ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB=audio
MONGO_MAX_POOL_SIZE=20
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=audio
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
RABBITMQ_URL=
RABBITMQ_PREFETCH=20
RABBITMQ_PREFETCH_WORKERS=1

# --- Qdrant (this namespace, audio_internal) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=audio_voices
SUGGESTION_LIMIT=5
VOICE_EMBEDDING_SIZE=256

# --- audio-api ---
ASR_STREAM_URL=ws://asr-worker:8020/v1/stream
MAX_UPLOAD_BYTES=2147483648
PROCESSING_STALL_SECONDS=900
POLL_HINT_MS=1500
POLL_BUDGET_PER_MINUTE=0
LOG_LEVEL=info

# --- GPU workers. HF_TOKEN is required: the diarization model is gated. ---
HF_TOKEN=
HF_HOME=/models/hf
HF_HUB_OFFLINE=0
DEVICE=cuda
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_REVISION=
EMBEDDING_MODEL=
EMBEDDING_REVISION=
SCRATCH_DIR=/tmp/audio
SCRATCH_CLEANUP_MINUTES=120
MIN_EMBED_SECONDS=1.0
ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3
ASR_REVISION=541d1f99c6b0c3cd0b11a95167540bb8edefd82b
STREAM_URL_BIND=0.0.0.0:8020
MAX_STREAM_SESSIONS=1
BATCH_MAX_TURNS=8
BATCH_MAX_SECONDS=60
ASR_GPU_BATCH_SIZE=8
GPU_LEASE_URL=redis://redis:6379
GPU_LEASE_TTL_MS=30000
GPU_LEASE_HEARTBEAT_MS=5000
