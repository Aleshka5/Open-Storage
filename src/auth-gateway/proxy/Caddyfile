{
	admin off
	email admin@filenkov.store
	servers {
		protocols h1 h2
	}
}

# Terminates TLS, sets HSTS, and forwards one upstream per host. It sets no other
# security header and does not route by application: that is the gateway's job,
# and a duplicated header is a defect (browsers intersect the policies).
(secure) {
	bind 192.168.1.102 10.10.0.1
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:8080
}

storage.filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:8080
}

image.filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:8080
}

rag.filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:8080
}

audio.filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:8080
}

llm.filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:8080
}

observer.filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:8080
}

id.filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:8080
}

# LAN and WireGuard only. Clients must trust this Caddy's local CA root; the
# failure looks like a certificate error, not a 404.
meet.filenkov.store {
	bind 192.168.1.102 10.10.0.1
	tls internal
	@lan remote_ip 10.10.0.0/24 192.168.1.0/24 127.0.0.1
	handle @lan {
		reverse_proxy 127.0.0.1:8080
	}
	respond 403
}

# Outside the SSO contract: the gateway does not authenticate it. It keeps a LAN
# and WireGuard gate (ADR-0005), so the dashboard is not reachable from the
# internet even though it has no SSO.
hermes.filenkov.store {
	import secure
	@lan remote_ip 10.10.0.0/24 192.168.1.0/24 127.0.0.1
	handle @lan {
		reverse_proxy 127.0.0.1:9119
	}
	respond 403
}

lite-llm.filenkov.store {
	import secure
	reverse_proxy 127.0.0.1:4000
}

# The HTTP redirect lists every site name: with an explicit bind, Caddy does not
# create it by itself.
http://filenkov.store, http://storage.filenkov.store, http://image.filenkov.store,
http://rag.filenkov.store, http://audio.filenkov.store, http://llm.filenkov.store,
http://observer.filenkov.store, http://id.filenkov.store, http://meet.filenkov.store,
http://hermes.filenkov.store, http://lite-llm.filenkov.store {
	bind 192.168.1.102 10.10.0.1
	redir https://{host}{uri} permanent
}

# The SSO hosts all reach the same gateway; the size of this file is the price of
# one certificate per name and one upstream per host (ADR-0001).
